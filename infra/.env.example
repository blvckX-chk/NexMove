# ─────────────────────────────────────────────────────────────────────────────
# NexMove — variables d'environnement n8n + tunnel
# Copier en .env et renseigner. NE JAMAIS committer le .env réel.
# ─────────────────────────────────────────────────────────────────────────────

# URL PUBLIQUE FIXE (le cœur du correctif).
# Doit être STABLE dans le temps. Voir README-webhook-fix.md.
# Exemple avec un tunnel Cloudflare nommé lié à ton domaine :
N8N_PUBLIC_HOST=n8n.mondomaine.com

# Token du tunnel Cloudflare nommé (Zero Trust > Networks > Tunnels > ton tunnel).
# Approche recommandée : l'ingress (hostname -> http://n8n:5678) se configure
# dans le dashboard Cloudflare, pas dans un fichier.
CLOUDFLARE_TUNNEL_TOKEN=

# Token du bot Telegram (NexMove Bot Telegram).
# Utilisé par les expressions {{ $env.TELEGRAM_BOT_TOKEN }} de WF1 (getFile / download CV).
# Ce token n'est plus codé en dur dans les workflows.
TELEGRAM_BOT_TOKEN=

# Clé partagée FastAPI (header X-Forge-Nex-Key). Doit correspondre à FastAPI.
FORGE_NEX_KEY=forge_nex_secret_2026

# Fuseau (optionnel)
GENERIC_TIMEZONE=Africa/Abidjan
