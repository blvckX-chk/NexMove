TELEGRAM_TOKEN=
GOOGLE_SHEET_ID=
GENERIC_TIMEZONE=Africa/Porto-Novo
# Grounding web pour /mobilite (compte gratuit sur tavily.com). Optionnel :
# sans clé, /mobilite retombe sur les pistes IA (durcies).
