# forge-nex-api — variables d'environnement (copier en .env, ne pas committer le vrai .env)
# IMPORTANT : TELEGRAM_TOKEN doit être le token ACTUEL du bot (après révocation),
# sinon /postuler ne pourra pas envoyer les PDF.

GROQ_API_KEY=
# Fallback LLM multi-fournisseurs (bascule auto Cerebras -> Groq -> Gemini)
CEREBRAS_API_KEY=
GEMINI_API_KEY=
# Modèles LLM (configurables : mets à jour ici quand un fournisseur déprécie un modèle, sans toucher au code)
GROQ_MODEL=openai/gpt-oss-120b
GROQ_MODEL_FAST=openai/gpt-oss-20b
CEREBRAS_MODEL=gpt-oss-120b
CEREBRAS_MODEL_FAST=gemma-4-31b
GEMINI_MODEL=gemini-2.5-flash
GEMINI_MODEL_FAST=gemini-2.5-flash-lite
FORGE_NEX_API_KEY=forge_nex_secret_2026
TELEGRAM_TOKEN=
GOOGLE_SHEET_ID=
GENERIC_TIMEZONE=Africa/Porto-Novo
# Grounding web pour /mobilite (compte gratuit sur tavily.com). Optionnel :
# sans clé, /mobilite retombe sur les pistes IA (durcies).
TAVILY_API_KEY=

# --- WhatsApp Cloud API (optionnel) ---
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_VERIFY_TOKEN=nexmove_verify

# --- Messenger / Facebook Page (optionnel) ---
MESSENGER_TOKEN=
MESSENGER_VERIFY_TOKEN=nexmove_verify

# --- Contact / support (pour la commande /contact) ---
# ADMIN_CHAT_ID = ton chat_id Telegram (trouve-le avec @userinfobot). Les messages /contact
# sont transmis directement à ce chat. Vide -> juste l'affichage des canaux ci-dessous.
ADMIN_CHAT_ID=
CONTACT_EMAIL=
CONTACT_WHATSAPP=
CONTACT_CALENDAR=

# Veille : appel LLM (osint) par utilisateur pendant la collecte. 0 par défaut (évite les 429 sur
# quotas gratuits). Mettre 1 seulement si tu as des quotas LLM confortables.
COLLECT_OSINT_PER_USER=0
# Embeddings : modèles candidats essayés dans l'ordre (le 1er dispo pour la clé est retenu).
EMBED_MODELS=gemini-embedding-001,text-embedding-004,embedding-001

# --- Sources d'emplois structurées (optionnel) ---
# arbeitnow est utilisé sans clé. Adzuna = clés gratuites sur developer.adzuna.com :
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# Un ou plusieurs pays Adzuna (virgules) : fr, gb, ca, be, ch, de, es, it, nl, us, au, za, in...
ADZUNA_COUNTRY=fr,ca,be
# Requêtes de SECOURS uniquement : par défaut les requêtes s'adaptent aux mots-clés des utilisateurs
ADZUNA_QUERIES=developpeur,data,ingenieur
# EURAXESS : recherche par API (auto-sondée par défaut). Pour fixer l'endpoint exact, mettre l'URL
# avec {q} à la place du mot-clé (F12 > Network sur euraxess.ec.europa.eu/jobs/search). Facultatif :
EURAXESS_API=
# EURAXESS : ou un flux RSS explicite d'une recherche filtrée (facultatif) :
EURAXESS_RSS=
# Flux RSS additionnels (bourses/mobilité), séparés par des virgules
SOURCE_FEEDS_EXTRA=

# --- OCR (CV scannés / images) : actif automatiquement si tesseract est installé ---
# Langues tesseract (packs installés dans le Dockerfile : fra + eng)
OCR_LANG=fra+eng
# Nombre max de pages traitées par OCR (garde-fou perf)
OCR_MAX_PAGES=8
# Facteur de rendu des pages avant OCR (2.5 ≈ 216 dpi)
OCR_ZOOM=2.5
