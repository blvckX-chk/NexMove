{
  "name": "WF1 — NexMove Onboarding + Menu",
  "nodes": [
    {
      "parameters": {
        "updates": [
          "message",
          "callback_query"
        ],
        "additionalFields": {}
      },
      "id": "a1",
      "name": "📱 Telegram Trigger",
      "type": "n8n-nodes-base.telegramTrigger",
      "typeVersion": 1.1,
      "position": [
        -320,
        0
      ],
      "webhookId": "forge-nex-wf1",
      "credentials": {
        "telegramApi": {
          "id": "pEbrCfeE10aKpKC8",
          "name": "NexMove Bot Telegram"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const u = $input.first().json;\nconst cb = u.callback_query;\nconst msg = u.message;\nlet chat_id='', user_id='', username='utilisateur', text='', message_type='text', document_file_id=null, callback_data='', callback_id='', message_id='';\nif (cb) {\n  chat_id = String(cb.message?.chat?.id || '');\n  user_id = String(cb.from?.id || '');\n  username = cb.from?.username || 'utilisateur';\n  callback_data = cb.data || '';\n  callback_id = cb.id || '';\n  message_id = String(cb.message?.message_id || '');\n  message_type = 'callback';\n} else {\n  chat_id = String(msg?.chat?.id || '');\n  user_id = String(msg?.from?.id || '');\n  username = msg?.from?.username || 'utilisateur';\n  text = msg?.text || '';\n  const isDoc = !!msg?.document;\n  message_type = isDoc ? 'document' : 'text';\n  document_file_id = msg?.document?.file_id || null;\n}\nif (!chat_id) throw new Error('chat_id manquant');\nreturn [{ json: { chat_id, user_id, username, text, message_type, document_file_id, callback_data, callback_id, message_id } }];\n"
      },
      "id": "a2",
      "name": "🔍 Parser",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -100,
        0
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.message_type }}",
              "rightValue": "document",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "or"
        },
        "options": {}
      },
      "id": "a3",
      "name": "🔀 Document ?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        120,
        0
      ]
    },
    {
      "parameters": {
        "url": "=https://api.telegram.org/bot{{ $env.TELEGRAM_BOT_TOKEN }}/getFile?file_id={{ $json.document_file_id }}",
        "options": {
          "timeout": 10000
        }
      },
      "id": "a4",
      "name": "⬇️ Get File URL",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        340,
        -150
      ]
    },
    {
      "parameters": {
        "url": "=https://api.telegram.org/file/bot{{ $env.TELEGRAM_BOT_TOKEN }}/{{ $json.result.file_path }}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "file"
            }
          },
          "timeout": 30000
        }
      },
      "id": "a5",
      "name": "⬇️ Download CV",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        560,
        -150
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:8000/api/chat-cv",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Forge-Nex-Key",
              "value": "forge_nex_secret_2026"
            }
          ]
        },
        "sendBody": true,
        "contentType": "multipart-form-data",
        "bodyParameters": {
          "parameters": [
            {
              "parameterType": "formBinaryData",
              "name": "file",
              "inputDataFieldName": "data"
            },
            {
              "name": "user_id",
              "value": "={{ $('🔍 Parser').first().json.user_id }}"
            },
            {
              "name": "chat_id",
              "value": "={{ $('🔍 Parser').first().json.chat_id }}"
            },
            {
              "name": "username",
              "value": "={{ $('🔍 Parser').first().json.username }}"
            }
          ]
        },
        "options": {
          "timeout": 60000
        }
      },
      "id": "a6",
      "name": "🤖 NexMove Chat-CV",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        780,
        -150
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:8000/api/chat",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Forge-Nex-Key",
              "value": "forge_nex_secret_2026"
            }
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "keypair",
        "bodyParameters": {
          "parameters": [
            {
              "name": "user_id",
              "value": "={{ $json.user_id }}"
            },
            {
              "name": "chat_id",
              "value": "={{ $json.chat_id }}"
            },
            {
              "name": "username",
              "value": "={{ $json.username }}"
            },
            {
              "name": "text",
              "value": "={{ $json.text }}"
            },
            {
              "name": "message_type",
              "value": "={{ $json.message_type }}"
            },
            {
              "name": "callback_data",
              "value": "={{ $json.callback_data }}"
            },
            {
              "name": "callback_id",
              "value": "={{ $json.callback_id }}"
            },
            {
              "name": "message_id",
              "value": "={{ $json.message_id }}"
            }
          ]
        },
        "options": {
          "timeout": 30000
        }
      },
      "id": "a7",
      "name": "🤖 NexMove Chat",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        340,
        140
      ]
    }
  ],
  "connections": {
    "📱 Telegram Trigger": {
      "main": [
        [
          {
            "node": "🔍 Parser",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "🔍 Parser": {
      "main": [
        [
          {
            "node": "🔀 Document ?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "🔀 Document ?": {
      "main": [
        [
          {
            "node": "⬇️ Get File URL",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "🤖 NexMove Chat",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "⬇️ Get File URL": {
      "main": [
        [
          {
            "node": "⬇️ Download CV",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "⬇️ Download CV": {
      "main": [
        [
          {
            "node": "🤖 NexMove Chat-CV",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "binaryMode": "separate"
  },
  "tags": []
}